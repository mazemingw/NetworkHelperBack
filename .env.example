# Copy to .env and fill in local values. Never commit the real .env.
PORT=9895

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=networkhelper
DB_PASSWORD=
DB_NAME=NetworkHelper
DB_CONN_LIMIT=10
DB_QUEUE_LIMIT=0

# Generate a separate random signing secret; do not reuse a sample value.
DEV_AUTH_TOKEN_SECRET=
DEV_AUTH_TOKEN_TTL_MS=43200000

# Optional: plugin sharing via Alibaba Cloud OSS.
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_USE_STS=false
OSS_STS_DURATION_SECONDS=900
OSS_STS_TOKEN_NAME=networkhelper-plugin-share
OSS_STS_STRICT=false
PLUGIN_SHARE_MAX_BYTES=209715200
PLUGIN_SHARE_DOWNLOAD_URL_EXPIRES=900

# Private EFS images: separate bucket recommended. Falls back to OSS_BUCKET/OSS_REGION.
# The RAM principal needs PutObject, GetObject, GetObjectAcl on EFS-BACKUP/*.
EFS_OSS_BUCKET=
EFS_OSS_REGION=
EFS_BACKUP_MAX_BYTES=2147483648

# Private compressed diagnostic reports (not a static/public directory). No MySQL required.
# Mount persistent storage here in containers; default is ./data/diagnostics beside diagnostics.js.
DIAGNOSTIC_REPORT_DIR=
# Local retention is fixed at seven days; the legacy DIAGNOSTIC_RETENTION_DAYS option is ignored.
# Local report budget (1 GiB default); full storage returns 503 so clients retain their offline queue.
DIAGNOSTIC_MAX_LOCAL_BYTES=1073741824
# Hourly private archival. Defaults reuse OSS_BUCKET / OSS_REGION and existing OSS credentials.
DIAGNOSTIC_OSS_BUCKET=
DIAGNOSTIC_OSS_REGION=
DIAGNOSTIC_OSS_PREFIX=DIAGNOSTICS
